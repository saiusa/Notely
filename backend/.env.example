APP_NAME=Notely
APP_ENV=production
APP_KEY=
APP_DEBUG=false
PORT=8080
SANCTUM_STATEFUL_DOMAINS=notelyjournal.me

APP_URL=https://notelyjournal.me
FRONTEND_URL=https://notelyjournal.me

VITE_API_URL=/api
VITE_BACKEND_URL=https://notelyjournal.me
VITE_APP_NAME="${APP_NAME}"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ─── Database (Railway MySQL) ─────────────────────────────
DB_CONNECTION=mysql
DB_HOST=mysql.railway.internal
DB_PORT=3306
DB_DATABASE=railway
DB_USERNAME=root
DB_PASSWORD=

# ─── Session ─────────────────────────────────────────────
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.notelyjournal.me
SESSION_SAME_SITE=lax

# ─── Connections ─────────────────────────────────────────
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# ─── Mail (Resend) ────────────────────────────────────────
MAIL_MAILER=resend
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_ENCRYPTION=smtps
MAIL_FROM_ADDRESS="hello@notelyjournal.me"
MAIL_FROM_NAME="${APP_NAME}"

RESEND_API_KEY=

# ─── AWS (unused) ────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
